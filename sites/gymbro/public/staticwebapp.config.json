{
    "globalHeaders": {
        "Content-Security-Policy": "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src https://login.microsoftonline.com https://func-nygdev-api.azurewebsites.net https://nygdevcdn.blob.core.windows.net; frame-src https://login.microsoftonline.com; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains",
        "X-Frame-Options": "DENY",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "geolocation=(), camera=(), microphone=(), payment=()",
        "Cross-Origin-Opener-Policy": "same-origin-allow-popups",
        "Cross-Origin-Resource-Policy": "same-origin"
    },
    "routes": [
        {
            "route": "/assets/*",
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            }
        },
        {
            "route": "/auth.html",
            "headers": {
                "Content-Security-Policy": "default-src 'none'; script-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'",
                "X-Frame-Options": "SAMEORIGIN",
                "Cache-Control": "no-cache"
            }
        },
        {
            "route": "/index.html",
            "headers": {
                "Cache-Control": "no-cache"
            }
        }
    ],
    "responseOverrides": {
        "404": {
            "rewrite": "/404.html"
        }
    }
}
