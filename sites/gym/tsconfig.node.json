{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,

        // The config imports `vite.bridge-chunks.ts` by its full name, which
        // is what Vite's native config loader — the planned default — needs;
        // it resolves no bare specifiers. Allowed only because nothing here
        // is emitted.
        "allowImportingTsExtensions": true,
        "incremental": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "skipLibCheck": true
    },
    "include": ["vite.config.ts"]
}
